{
  "name": "pest-crm-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply pest-crm --remote",
    "db:migrate:local": "wrangler d1 migrations apply pest-crm --local",
    "db:seed": "wrangler d1 execute pest-crm --remote --file=./seed.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.128.0"
  }
}
